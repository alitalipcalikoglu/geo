{
  "name": "@atc-web/geo",
  "version": "1.0.0",
  "private": true,
  "description": "Geo and reference lookups: IP to country, city, coordinates and time zone from an MMDB file read without dependencies; countries, currencies, time zones and calling codes with localized names; E.164 phone normalization; distances; your own place collections with nearby search",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alitalipcalikoglu/geo.git"
  },
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file=.env src/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "@atc-web/service-core": "github:alitalipcalikoglu/service-core#v1.6.0",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.4"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2"
  }
}
