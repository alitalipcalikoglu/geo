# --- Server ---
PORT=3012
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Request body limit, bytes (place uploads must fit).
BODY_LIMIT=2097152

# --- Storage ---
DB_PATH=./data/geo.db
# IP geolocation database in MaxMind DB format: GeoLite2-City.mmdb, GeoLite2-Country.mmdb, dbip-city-lite.mmdb,
# ipinfo country.mmdb ... Leave empty to run without IP geolocation (IP classification and every other lookup still work).
# Replace the file in place and call POST /v1/database/reload after updates.
MMDB_PATH=
# Optional ASN database (GeoLite2-ASN.mmdb, dbip-asn-lite.mmdb).
ASN_MMDB_PATH=

# --- Callers: id:secret[:role], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: read (lookups, reference data, nearby), write (collections and places, database reload), readwrite (default).
GEO_API_KEYS=console:REPLACE_WITH_64_HEX_CHARS,shop-backend:REPLACE_WITH_64_HEX_CHARS:read
# Requests per key per minute.
RATE_LIMIT_MAX=3000

# --- Limits ---
# IPs or phone numbers per batch request; places per collection; largest radius for nearby queries (km).
MAX_BATCH=100
MAX_POINTS=5000
MAX_RADIUS_KM=500
# Language for names when the request does not say (BCP 47).
DEFAULT_LANG=en
